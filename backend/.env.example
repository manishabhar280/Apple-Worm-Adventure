NODE_ENV=production
PORT=10000
FRONTEND_ORIGIN=https://your-frontend-host.example
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1h
# No real ad provider is integrated; keep rewards disabled in production.
REWARDED_AD_PROVIDER=unconfigured
REWARD_SIMULATION_MIN_WATCH_SECONDS=5
